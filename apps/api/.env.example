NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://runcast:runcast@localhost:5432/runcast
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
APPLE_CLIENT_ID=com.example.runcast
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_URL=http://localhost:3000/v1/integrations/strava/callback
# Match the installed profile: runcast-dev for development, runcast-preview for staging.
MOBILE_DEEP_LINK=runcast-dev://account
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
OPENAPI_ENABLED=true
# Current planning is always enabled; canopy weighting can be disabled independently.
CANOPY_MODEL_MODE=active
WATCH_REVISION_MODE=off
# Unpublished, unreferenced closed-window evaluations only (minimum 7 days).
EVALUATION_RETENTION_DAYS=30
DEPLOYMENT_ENVIRONMENT=local
# Optional outside Render. Render supplies RENDER_GIT_COMMIT automatically.
RELEASE_SHA=development
