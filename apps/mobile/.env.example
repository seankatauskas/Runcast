EXPO_PUBLIC_API_URL=http://localhost:3000
# Optional development bridge when the iOS simulator cannot resolve external DNS.
# In an isolated E2E simulator build, setting this URL opts the visual-review app into live weather.
# EXPO_PUBLIC_OPEN_METEO_BASE_URL=http://127.0.0.1:8098/v1/forecast
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LEGAL_BASE_URL=https://runcast-legal.onrender.com
# Demo-route radiation model; set to off for the immediate open-sky rollback.
EXPO_PUBLIC_CANOPY_MODEL_MODE=active
# E2E builds only. Never set this for preview or production; use the isolated EAS e2e profile.
# EXPO_PUBLIC_E2E_MODE=enabled
# Public client key. Leave blank in local development to keep Sentry a no-op.
EXPO_PUBLIC_SENTRY_DSN=
# Set by EAS secrets or the build environment; never commit the real value.
EAS_PROJECT_ID=
# Source-map upload configuration. Store SENTRY_AUTH_TOKEN as a sensitive EAS variable.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
